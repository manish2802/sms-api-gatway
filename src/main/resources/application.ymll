server:
  port: 8000

spring:
  application:
    name: api-gateway

  cloud:
    gateway:
      routes:
        - id: sms-stock-service
          uri: lb://SMS-STOCK-SERVICE
          predicates:
            - Path=/stocks/**
            
        - id: sms-stock-swagger
          uri: lb://SMS-STOCK-SERVICE
          predicates:
            - Path=/swagger-ui/**

        - id: sms-stock-api-docs
          uri: lb://SMS-STOCK-SERVICE
          predicates:
            - Path=/v3/api-docs/**
            
        - id: sms-order-service
          uri: lb://SMS-ORDER-SERVICE
          predicates:
            - Path=/api/orders/**    
           
eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka
 